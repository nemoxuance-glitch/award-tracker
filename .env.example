# Copy this file to .env and fill in the values.

# --- Firebase web config (public; bundled into the browser app) ---
# Only variables starting with VITE_ are exposed to the frontend by Vite.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server only (secret; NO VITE_ prefix, never sent to the browser) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: port for the Express server (default 3001)
# PORT=3001
